# With the run's downloaded greenops-exo-<run-id>.json in the repo root (git-ignored), only
# GREENOPS_GRID_SECRET is needed here. Otherwise fill in all values.
# Copy to .local/greenops.env (git-ignored) and fill in the values from the run's page.
# greenops.live reads it automatically; variables already set in the environment win.
# Never commit the filled-in copy.
EXOSCALE_API_KEY=
EXOSCALE_API_SECRET=
# https://<host>/runs/<run-id>/cloud/v2
GREENOPS_CLOUD_ENDPOINT=
# Optional: derived from the cloud endpoint (https://<host>/runs/<run-id>/grid/v4)
GREENOPS_GRID_ENDPOINT=
GREENOPS_GRID_SECRET=
